{
	"schemaVersion": 1,
	"id": "lambdabettergrass",
	"name": "LambdaBetterGrass",
	"version": "${version}",
	"description": "Adds actual better grass and better snow while being customizable!",
	"authors": [
		"LambdAurora"
	],
	"contact": {
		"homepage": "https://lambdaurora.dev/projects/lambdabettergrass",
		"sources": "https://github.com/LambdAurora/LambdaBetterGrass.git",
		"issues": "https://github.com/LambdAurora/LambdaBetterGrass/issues"
	},
	"license": "Lambda License",
	"icon": "assets/lambdabettergrass/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.lambdaurora.lambdabettergrass.LambdaBetterGrass::INSTANCE"
		],
		"modmenu": [
			"dev.lambdaurora.lambdabettergrass.LambdaBetterGrassModMenu"
		],
		"fabric-datagen": [
			"dev.lambdaurora.lambdabettergrass.resource.LBGDataGen"
		]
	},
	"accessWidener": "lambdabettergrass.accesswidener",
	"mixins": [
		"lambdabettergrass.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.9",
		"minecraft": "~1.20 <1.20.2-",
		"spruceui": ">=6.2.1",
		"java": ">=17",
		"fabric-model-loading-api-v1": "*",
		"fabric-renderer-api-v1": "*",
		"fabric-resource-loader-v0": "*"
	},
	"recommends": {
		"modmenu": ">=7.0.0"
	},
	"breaks": {
		"optifabric": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/lambdabettergrass",
				"modmenu.discord": "https://discord.lambdaurora.dev/",
				"modmenu.github_releases": "https://github.com/LambdAurora/LambdaBetterGrass/releases",
				"modmenu.modrinth": "https://modrinth.com/mod/lambdabettergrass",
				"modmenu.bluesky": "https://bsky.app/profile/lambdaurora.dev"
			}
		}
	}
}
